# Turso Database
TURSO_CONNECTION_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Better Auth
# PENTING: Di Vercel, isi dengan URL produksi, contoh: https://cashflow-ocm.vercel.app
BETTER_AUTH_SECRET=your-secret-key-minimum-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# App URL (used for auth redirects)
# PENTING: Di Vercel, isi dengan URL produksi, contoh: https://cashflow-ocm.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob Storage (untuk upload foto + simpan backup terjadwal)
# Dapatkan dari: Vercel Dashboard > Storage > Blob > Create Store > .env.local
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# Cron daily-summary (WAJIB di produksi, kalau tidak cron 401).
# Vercel Cron mengirim header Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=your-cron-secret

# Backup terjadwal (POST /api/backup, header Authorization: Bearer <BACKUP_TOKEN>).
BACKUP_TOKEN=your-backup-token

# Telegram bot (notifikasi transaksi + briefing harian). Opsional — kalau kosong,
# notifikasi nonaktif. CHAT_ID = id chat/grup tujuan; WEBHOOK_SECRET = token rahasia
# header X-Telegram-Bot-Api-Secret-Token untuk verifikasi webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Origin tambahan yang dipercaya better-auth (koma-separated), mis. custom domain.
# Contoh: https://omandacerli.com,https://www.omandacerli.com
ADDITIONAL_TRUSTED_ORIGINS=
