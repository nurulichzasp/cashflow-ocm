{
  "tables": {
    "prah_angkutan": {
      "columns": {
        "id": { "type": "TEXT", "nullable": false, "unique": true },
        "tanggal": { "type": "TEXT", "nullable": false },
        "truk": { "type": "TEXT", "nullable": false, "cardinality_estimate": 2 },
        "peron_muat": { "type": "TEXT", "nullable": false, "default": "Nolin" },
        "no_bast": { "type": "TEXT", "nullable": true },
        "no_tid": { "type": "TEXT", "nullable": true },
        "sumber": { "type": "TEXT", "nullable": false, "default": "manual", "cardinality_estimate": 3 },
        "penjualan_id": { "type": "TEXT", "nullable": true, "foreign_key": "penjualan.id" },
        "source_key": { "type": "TEXT", "nullable": true },
        "tonase_kotor": { "type": "REAL", "nullable": false },
        "tonase_netto_1": { "type": "REAL", "nullable": false },
        "tarif_per_kg": { "type": "INTEGER", "nullable": false, "default": 140 },
        "pendapatan": { "type": "INTEGER", "nullable": false },
        "biaya_sopir": { "type": "INTEGER", "nullable": false, "default": 200000 },
        "catatan": { "type": "TEXT", "nullable": true },
        "created_by": { "type": "TEXT", "nullable": false, "foreign_key": "user.id" },
        "idempotency_key": { "type": "TEXT", "nullable": true, "unique": true },
        "created_at": { "type": "INTEGER", "nullable": false, "default": "unixepoch()" }
      },
      "primary_key": ["id"],
      "unique_constraints": [["idempotency_key"], ["no_bast", "source_key"]],
      "check_constraints": {
        "truk_valid": "truk IN ('katimin', 'doni')",
        "tonase_kotor_valid": "tonase_kotor > 0 AND tonase_kotor <= 100000",
        "tonase_netto_valid": "tonase_netto_1 > 0 AND tonase_netto_1 <= tonase_kotor",
        "tarif_non_negative": "tarif_per_kg >= 0",
        "pendapatan_non_negative": "pendapatan >= 0",
        "biaya_sopir_non_negative": "biaya_sopir >= 0"
      },
      "indexes": [
        { "name": "prah_angkutan_idempotency_idx", "columns": ["idempotency_key"], "unique": true },
        { "name": "prah_angkutan_tanggal_created_idx", "columns": ["tanggal", "created_at"] },
        { "name": "prah_angkutan_truk_tanggal_idx", "columns": ["truk", "tanggal"] },
        { "name": "prah_angkutan_created_by_idx", "columns": ["created_by"] },
        { "name": "prah_angkutan_penjualan_idx", "columns": ["penjualan_id"] },
        { "name": "prah_angkutan_bast_source_idx", "columns": ["no_bast", "source_key"], "unique": true }
      ]
    },
    "prah_bbm": {
      "columns": {
        "id": { "type": "TEXT", "nullable": false, "unique": true },
        "tanggal": { "type": "TEXT", "nullable": false },
        "truk": { "type": "TEXT", "nullable": false, "cardinality_estimate": 2 },
        "jumlah_ken": { "type": "INTEGER", "nullable": false },
        "biaya_total": { "type": "INTEGER", "nullable": false },
        "catatan": { "type": "TEXT", "nullable": true },
        "created_by": { "type": "TEXT", "nullable": false, "foreign_key": "user.id" },
        "idempotency_key": { "type": "TEXT", "nullable": true, "unique": true },
        "created_at": { "type": "INTEGER", "nullable": false, "default": "unixepoch()" }
      },
      "primary_key": ["id"],
      "unique_constraints": [["idempotency_key"]],
      "check_constraints": {
        "truk_valid": "truk IN ('katimin', 'doni')",
        "jumlah_ken_positive": "jumlah_ken > 0",
        "biaya_total_positive": "biaya_total > 0"
      },
      "indexes": [
        { "name": "prah_bbm_idempotency_idx", "columns": ["idempotency_key"], "unique": true },
        { "name": "prah_bbm_tanggal_created_idx", "columns": ["tanggal", "created_at"] },
        { "name": "prah_bbm_truk_tanggal_idx", "columns": ["truk", "tanggal"] },
        { "name": "prah_bbm_created_by_idx", "columns": ["created_by"] }
      ]
    }
  }
}
